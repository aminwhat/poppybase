{
  "name": "poppybase",
  "version": "0.0.1",
  "description": "Just A Seed",
  "scripts": {
    "start": "cross-env NODE_ENV=production node --max_old_space_size=4096 ./build/src/app.js",
    "build": "npx swc ./src -d ./build && npm run sentry:sourcemaps",
    "dev": "cross-env NODE_ENV=development nodemon ./src/app.ts"
  },
